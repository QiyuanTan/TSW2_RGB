<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap10 rescap">
  <Identity Name="QiyuanTan.TSW2RGB.AmbientProbe"
            Publisher="CN=QiyuanTan TSW2 RGB Development"
            Version="1.0.0.0"
            ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>TSW2 RGB Ambient Probe</DisplayName>
    <PublisherDisplayName>QiyuanTan TSW2 RGB Development</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.23466.0" MaxVersionTested="10.0.28120.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="AmbientProbe"
                 Executable="AmbientRgbProbe.exe"
                 uap10:RuntimeBehavior="win32App"
                 uap10:TrustLevel="mediumIL">
      <uap:VisualElements AppListEntry="none"
                          DisplayName="TSW2 RGB Ambient Probe"
                          Description="Manual background LampArray transport diagnostic"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.lighting"
                             Id="AmbientLighting"
                             PublicFolder="public"
                             DisplayName="TSW2 RGB Ambient Probe" />
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
